# Development values only; never use in production.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
# Production single-origin hosting: true (requires npm run build first).
SERVE_WEB=false
# Keep empty locally. At hosting time, list only verified proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
# Optional absolute path to the provider CA certificate for verified production TLS.
# DATABASE_SSL_CA_FILE=
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:54329/plyvra
WEB_ORIGIN=http://localhost:5173
# Comma-separated exact LAN origins, e.g. http://192.168.1.10:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Local file outbox (default). Use smtp with Mailpit if Docker is installed.
MAIL_TRANSPORT=outbox
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Playboard <hello@playboard.local>
# Render Free blocks standard SMTP ports; use MAIL_TRANSPORT=brevo and HTTPS API.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=verified-sender@example.com
