{
  "name": "playboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/backup.ts --restore",
    "db:maintenance": "tsx scripts/maintenance.ts",
    "db:verify-backup": "tsx scripts/verify-backup.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsup apps/server/src/index.ts apps/server/src/board-bot-worker.ts --format esm --out-dir dist/server --platform node --external pg-native && node scripts/copy-worker.mjs",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.mjs",
    "test": "tsx scripts/test-db.ts && vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "chess.js": "^1.4.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "i18next": "^26.4.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
